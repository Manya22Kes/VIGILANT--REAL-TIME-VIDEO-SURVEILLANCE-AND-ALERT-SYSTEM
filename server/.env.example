PORT=4000
INFERENCE_SERVICE_URL=http://localhost:8001
CONFIDENCE_THRESHOLD=0.5
ALERT_COOLDOWN_SECONDS=10
DWELL_GAP_SECONDS=3

# Weapon alerts (only active when the inference service has a weapon model)
WEAPON_CONFIDENCE_THRESHOLD=0.5
WEAPON_COOLDOWN_SECONDS=5
WEAPON_MIN_CONSECUTIVE_FRAMES=2

# Crowd alerts and detection size (these start as defaults; the UI can change them live)
CROWD_THRESHOLD=4
CROWD_CONFIDENCE=0.35
CROWD_MIN_CONSECUTIVE_FRAMES=2
INFERENCE_IMGSZ=640
DENSE_COUNTING=1
CORS_ORIGIN=http://localhost:5173

# SMS alerts through textbee.dev (optional; off unless the key AND recipients are set).
# Needs an Android phone with the TextBee app, signed in and online. Get the API key from
# the textbee.dev dashboard. Numbers must be international format, comma separated.
# Free plan = 50 SMS/day and 300/month, each recipient counts as one, so the limits below
# keep it from burning the quota. Never commit your real key.
# TEXTBEE_API_KEY=
# SMS_RECIPIENTS=+919876543210,+919812345678
# TEXTBEE_DEVICE_ID=          # optional: pick a specific phone (default: your default device)
SMS_MIN_SEVERITY=HIGH         # LOW, MEDIUM or HIGH: only alerts at or above this are texted
SMS_ALERT_TYPES=weapon,zone_intrusion,crowd
SMS_COOLDOWN_SECONDS=300      # at most one SMS per alert type in this window
SMS_DAILY_LIMIT=40            # messages per day (each recipient counts); resets at midnight

# Single admin password for zone reconfiguration. Set this to a real
# passphrase - it is hashed with bcrypt in memory at startup and never
# compared in plaintext. Anyone with this password can log in.
ADMIN_PASSWORD=change-me

# Secret used to sign admin login JWTs. Set this to a long random string
# (e.g. `openssl rand -hex 32`) - do not reuse the example value.
ADMIN_JWT_SECRET=change-me-too
